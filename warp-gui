#!/usr/bin/env bash
# Launcher for the Cloudflare WARP GUI. Resolves its own location so it works
# from a symlink (e.g. ~/.local/bin/warp-gui).
set -euo pipefail
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
exec python3 "$DIR/main.py" "$@"
