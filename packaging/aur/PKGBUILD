# Maintainer: Sarthak-Awasthi <bengdeeba@gmail.com>
pkgname=warp-gui
pkgver=1.0.0
pkgrel=1
pkgdesc="Unofficial Linux GUI (system tray + window) for the Cloudflare WARP client (warp-cli)"
arch=('any')
url="https://github.com/Sarthak-Awasthi/warp-gui"
license=('MIT')
depends=('python' 'python-pyqt5')
optdepends=('cloudflare-warp-bin: the official Cloudflare WARP client (required at runtime)')
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/Sarthak-Awasthi/warp-gui/archive/refs/tags/v$pkgver.tar.gz")
# Replace with the real checksum: `updpkgsums` (from pacman-contrib) or
# `makepkg -g`. Left as SKIP so the recipe builds before the tag is published.
sha256sums=('SKIP')

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
